{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "email-service-staging",
      "workers_dev": false
    }
  }
}