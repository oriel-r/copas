{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "api"
    }
  ],
  "env": {
    "staging": {
      "name": "client-staging",
      "services": [
        {
          "binding": "API_SERVICE",
          "service": "api-staging"
        }
      ]
    }
  }
}

