{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copas-auth",
      "database_id": "<PRODUCTION_DATABASE_ID>",
      "preview_database_id": "local-copas-auth",
      "migrations_dir": "../../../../packages/db/migrations",
      "migrations_pattern": "../../../../packages/db/migrations/*/migration.sql"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "<PRODUCTION_KV_NAMESPACE_ID>",
      "preview_id": "local-copas-auth-kv"
    }
  ],

  "r2_buckets": [
    {
      "binding": "DOCUMENT_BUCKET",
      "bucket_name": "copas-documents",
      "preview_bucket_name": "local-copas-documents"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "copas-ai-extraction"
      }
    ],
    "consumers": [
      {
        "queue": "copas-ai-result",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "copas-ai-result-dlq",
        "retry_delay": 60
      }
    ]
  },

  "vars": {
    "BACKEND_URL": "http://localhost:8787",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "CLIENT_URL": "http://localhost:5173",
    "NODE_ENV": "development"
  },

  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_SECRET",
      "MICROSOFT_TENANT_ID"
    ]
  },

  "env": {
    "staging": {
      "name": "api-staging",
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "MICROSOFT_CLIENT_ID",
          "MICROSOFT_CLIENT_SECRET",
          "MICROSOFT_TENANT_ID"
        ]
      },
      "vars": {
        "BACKEND_URL": "https://api-staging.example.com",
        "BETTER_AUTH_URL": "https://api-staging.example.com",
        "CLIENT_URL": "https://app-staging.example.com",
        "NODE_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "copas-auth-staging",
          "database_id": "<STAGING_DATABASE_ID>",
          "migrations_dir": "../../../../packages/db/migrations",
          "migrations_pattern": "../../../../packages/db/migrations/*/migration.sql"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "<STAGING_KV_NAMESPACE_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENT_BUCKET",
          "bucket_name": "copas-documents-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "AI_QUEUE",
            "queue": "copas-ai-extraction-staging"
          }
        ],
        "consumers": [
          {
            "queue": "copas-ai-result-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "copas-ai-result-dlq-staging",
            "retry_delay": 60
          }
        ]
      }
    }
  }
}
