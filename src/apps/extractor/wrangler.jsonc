{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extractor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_RESULT_QUEUE",
        "queue": "copas-ai-result"
      }
    ],
    "consumers": [
      {
        "queue": "copas-ai-extraction",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "copas-ai-extraction-dlq",
        "retry_delay": 60
      }
    ]
  },
  "vars": {
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "secrets": {
    "required": [
      "MISTRAL_API_KEY"
    ]
  },
  "env": {
    "staging": {
      "name": "extractor-staging",
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "secrets": {
        "required": ["MISTRAL_API_KEY"]
      },
      "queues": {
        "producers": [
          {
            "binding": "AI_RESULT_QUEUE",
            "queue": "copas-ai-result-staging"
          }
        ],
        "consumers": [
          {
            "queue": "copas-ai-extraction-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "copas-ai-extraction-dlq-staging",
            "retry_delay": 60
          }
        ]
      },
      "vars": {
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
      }
    }
  }
}
