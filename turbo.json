{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["*"]
    },
    "lint": {
      "passThroughEnv": ["*"]
    },
    "test": {
      "passThroughEnv": ["*"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/stryker/**"],
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}
