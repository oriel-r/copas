{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {},
    "test:mutation": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/stryker/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
