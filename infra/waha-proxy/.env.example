# Puerto local del proxy (exponer únicamente este puerto vía Tailscale Funnel)
PORT=8080
PROXY_PORT=8080
WAHA_LOCAL_PORT=3000

# Observabilidad (LogTape)
LOG_LEVEL=info
LOG_FORMAT=pretty

# Engine WAHA recomendado para múltiples sesiones con bajo consumo (NOWEB | GOWS | WEBJS)
WHATSAPP_DEFAULT_ENGINE=NOWEB

# Conexión interna hacia WAHA (en Docker Compose usa http://waha:3000)
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=change-me-waha-api-key
WAHA_DEFAULT_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=change-me-waha-webhook-hmac-key

# Seguridad del Proxy expuesto en Tailscale Funnel
# Debe coincidir con WHATSAPP_ACCESS_TOKEN configurado en CoPAS (api / D1)
PROXY_BEARER_TOKEN=change-me-copas-bearer-token
# Header secreto adicional opcional (dejar vacío para compatibilidad estricta solo con Bearer)
PROXY_EXTRA_SECRET=

# Portal remoto de vinculación QR (independiente de PROXY_BEARER_TOKEN)
ENABLE_QR_PORTAL=true
QR_ADMIN_LOCAL_ONLY=true
QR_PUBLIC_BASE_URL=
QR_PORTAL_TOKEN=change-me-qr-admin-token
QR_INVITE_SECRET=change-me-qr-invite-hmac-secret
QR_INVITE_DEFAULT_TTL_SEC=900

# Emulación de webhooks hacia whatsapp-service (/webhooks/whatsapp)
# Ejemplo: https://whatsapp-service-staging.<tu-subdominio>.workers.dev/webhooks/whatsapp
COPAS_WEBHOOK_URL=
# Debe coincidir exactamente con META_APP_SECRET en whatsapp-service
META_APP_SECRET=change-me-meta-app-secret
META_WABA_ID=waha-proxy-waba

# Persistencia y configuración local
DB_PATH=/app/data/proxy.db
SESSIONS_CONFIG_PATH=/app/config/sessions.json
TEMPLATES_CONFIG_PATH=/app/config/templates.json

# Comportamiento humano y validación
WAHA_CHECK_NUMBER_EXISTS=false
DISCONNECTED_SESSION_HTTP_STATUS=503
HUMAN_MIN_COOLDOWN_MS=4000
HUMAN_MAX_COOLDOWN_MS=10000
HUMAN_TYPING_MS_PER_CHAR=45
HUMAN_MIN_TYPING_MS=1800
HUMAN_MAX_TYPING_MS=7000
MAX_SEND_RETRIES=3
