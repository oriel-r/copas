{
  "subagent-boundary-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|write_to_file|replace_file_content|multi_replace_file_content|grep_search|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/enforce-boundaries.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
